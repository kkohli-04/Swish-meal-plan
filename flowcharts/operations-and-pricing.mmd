  classDef exc fill:#FFF4DE,stroke:#F5C46B,stroke-width:2px,color:#6E4300
  classDef stop fill:#FDECEC,stroke:#F2A7A9,stroke-width:2px,color:#8C1F23
  classDef neutral fill:#FFFFFF,stroke:#DDE6E0,stroke-width:2px,color:#4B5751
